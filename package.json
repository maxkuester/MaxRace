{
  "name": "maxrace",
  "productName": "MaxRace",
  "version": "1.0.0",
  "description": "MaxRace sailing race dashboard",
  "main": "main.js",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "fonts": "node scripts/fetch-fonts.js",
    "dist": "node scripts/fetch-fonts.js && node scripts/fetch-vendor.js && electron-builder --publish never",
    "server": "node server.js",
    "cap:web": "node scripts/build-native-web.js",
    "vendor": "node scripts/fetch-vendor.js",
    "cap:sync": "node scripts/fetch-fonts.js && node scripts/fetch-vendor.js && node scripts/build-native-web.js && cap sync"
  },
  "devDependencies": {
    "@capacitor/android": "8.6.0",
    "@capacitor/cli": "8.6.0",
    "@capacitor/core": "8.6.0",
    "@capacitor/ios": "8.6.0",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.maxrace.dash",
    "productName": "MaxRace",
    "files": [
      "main.js",
      "server.js",
      "scan.js",
      "maxrace.html",
      "targets.js",
      "voice.js",
      "calib.js",
      "marksimport.js",
      "grib.js",
      "llm.js",
      "racedocs.js",
      "polarlearn.js",
      "speedcal.js",
      "voicepack.js",
      "voicepack/**/*",
      "scripts/target-tack.js",
      "vendor/**",
      "fonts/**",
      "build/icon.png"
    ],
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "artifactName": "MaxRace-${version}-${os}-${arch}.${ext}",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "MaxRace",
      "artifactName": "MaxRace-Setup.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "category": "public.app-category.sports",
      "icon": "build/icon.png"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Utility",
      "icon": "build/icon.png"
    },
    "dmg": {
      "artifactName": "MaxRace.${ext}"
    }
  }
}
